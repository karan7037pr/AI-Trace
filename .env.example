# Copy this file to .env only if you choose to load environment variables
# with a tool such as python-dotenv. Never commit the real key.
GROQ_API_KEY=put-your-groq-key-here
GROQ_MODEL=openai/gpt-oss-20b
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Full question/context/answer sampling is disabled unless explicitly enabled.
AITRACE_CONTENT_SAMPLING=false
AITRACE_SAMPLE_RATE=0.05
AITRACE_EVALUATION_URL=http://localhost:8080/api/v1/evaluation-jobs
